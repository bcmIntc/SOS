#!/bin/bash
# Generated by config.status; run inside an existing MPI/PBS allocation.
# Defaults match the customer command in launch.sh.o991509.
# Example: NODES=8 CORES_PER_NODE=104 bash build/scripts/launch-node-budget.sh
# Arguments replace the entire default benchmark argument list.
set -euo pipefail

die() { printf 'ERROR: %s\n' "$*" >&2; exit 2; }
positive() {
    [[ $1 =~ ^[1-9][0-9]*$ && ${#1} -le 6 ]] ||
        die "$2 must be a positive integer of at most six digits"
}
if [[ ${1:-} == --help ]]; then
    cat <<'USAGE'
Usage: bash launch-node-budget.sh [benchmark arguments...]
Environment:
  NODES=8 CORES_PER_NODE=104 REPEATS=3
  BENCHMARK=/home/mfbrown/Code/applications.hpc.workloads.pgas.pgas-dev/benchmark/benchmark
  SOS_LIB_DIR=<configured build>/src/.libs
  MPIRUN=mpirun SOS_OFI_TEST_TIMEOUT=1800s
  CORE_MAP=<optional physical-core map, one integer per line>
  SOS_OFI_LOG_DIR=<fresh log directory>
  SHMEM_SYMMETRIC_SIZE=3G (customer benchmark default)

Default benchmark arguments: 1896 -m 1024 -M 8192 --seed 1784684348
Runs independent-64, independent-128, shared-64 in rotating order.
All arms use counter retirement, registered sources, and FI_MORE off.
MPI arguments are -n NODES*CORES_PER_NODE -ppn CORES_PER_NODE -no-vni.
Existing MPI pinning variables are preserved. CORE_MAP adds --cpu-bind list:...
BENCHMARK must print the customer PEs: and Error rate = N/T summaries.
This script does not submit a job, build SOS, or change system settings.
USAGE
    exit 0
fi

nodes=${NODES:-8}
cores=${CORES_PER_NODE:-104}
repeats=${REPEATS:-3}
for item in nodes cores repeats; do positive "${!item}" "$item"; done
((nodes >= 2)) || die "this comparison requires at least two nodes"
pes=$((nodes * cores))
budget=$((cores * 64))
benchmark=${BENCHMARK:-/home/mfbrown/Code/applications.hpc.workloads.pgas.pgas-dev/benchmark/benchmark}
launcher=${MPIRUN:-mpirun}
sos_lib_dir=${SOS_LIB_DIR:-@abs_top_builddir@/src/.libs}
log_dir=${SOS_OFI_LOG_DIR:-@abs_top_builddir@/logs/customer-node-budget-$(date +%Y%m%d-%H%M%S)}
timeout_duration=${SOS_OFI_TEST_TIMEOUT:-1800s}
[[ $timeout_duration =~ ^[0-9]+([.][0-9]+)?[smhd]?$ && $timeout_duration =~ [1-9] ]] ||
    die "SOS_OFI_TEST_TIMEOUT must be a nonzero GNU timeout duration"
[[ -x $benchmark ]] || die "benchmark is not executable: $benchmark"
for tool in "$launcher" timeout sha256sum ldd readlink awk grep strings; do
    command -v "$tool" >/dev/null || die "missing executable: $tool"
done
[[ -d $sos_lib_dir ]] || die "missing library directory: $sos_lib_dir"
sos_lib_dir=$(cd -- "$sos_lib_dir" && pwd -P)
[[ -f $sos_lib_dir/libsma.so ]] || die "missing $sos_lib_dir/libsma.so"
library=$(readlink -f -- "$sos_lib_dir/libsma.so")
export LD_LIBRARY_PATH="$sos_lib_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
if ! linked=$(ldd "$benchmark" 2>&1); then die "cannot inspect benchmark linkage: $linked"; fi
loaded=$(awk '$1 ~ /^libsma[.]so/ && $2 == "=>" {print $3; exit}' <<<"$linked")
[[ -n $loaded && -f $loaded ]] || die "benchmark must dynamically link to libsma.so"
[[ $(readlink -f -- "$loaded") == "$library" ]] ||
    die "benchmark resolves to $loaded instead of $library"
# Read the full strings stream: grep -q can cause SIGPIPE under pipefail.
strings "$library" | grep -F 'OFI node budget:' >/dev/null ||
    die "selected library lacks the node-budget experiment"
library_hash=$(sha256sum "$library")
library_hash=${library_hash%% *}
launcher_args=(-n "$pes" -ppn "$cores" -no-vni)
if [[ -n ${CORE_MAP:-} ]]; then
    [[ -r $CORE_MAP ]] || die "cannot read CORE_MAP=$CORE_MAP"
    core_ids=()
    while IFS= read -r core || [[ -n $core ]]; do
        [[ $core =~ ^[0-9]+$ ]] || die "CORE_MAP must contain one integer per line"
        core_ids+=("$core")
    done <"$CORE_MAP"
    [[ ${#core_ids[@]} == "$cores" ]] || die "CORE_MAP must contain $cores entries"
    core_list=$(IFS=:; printf '%s' "${core_ids[*]}")
    launcher_args+=(--cpu-bind "list:$core_list")
fi
benchmark_args=(1896 -m 1024 -M 8192 --seed 1784684348)
if (($#)); then benchmark_args=("$@"); fi
[[ ! -e $log_dir ]] || die "use a fresh SOS_OFI_LOG_DIR: $log_dir"
mkdir -p -- "$log_dir"
log_dir=$(cd -- "$log_dir" && pwd -P)
export SHMEM_INFO=1 SHMEM_DEBUG=0 SHMEM_SYMMETRIC_SIZE=${SHMEM_SYMMETRIC_SIZE:-3G}
export SHMEM_OFI_PROVIDER=cxi SHMEM_OFI_BOUNCE_LOCAL_MR=1
export SHMEM_OFI_BOUNCE_COUNTER_RETIRE=1 SHMEM_OFI_PUT_MORE_BATCH=0
export SHMEM_OFI_PUT_MORE_MIN=0 SHMEM_OFI_PUT_MORE_MAX=0
export SHMEM_OFI_PUT_BATCH_STATS=1 SHMEM_OFI_CQ_BATCH_SIZE=1
export SHMEM_OFI_STX_MAX=0 SHMEM_OFI_STX_AUTO=0
export SHMEM_BOUNCE_SHEAP=1 SHMEM_BOUNCE_SIZE=8192 SHMEM_OFI_BOUNCE_NODE_CHUNK=16
export SHMEM_MAX_BOUNCE_BUFFERS=128 SHMEM_OFI_BOUNCE_NODE_BUDGET=0
export SHMEM_BARRIER_ALGORITHM=${SHMEM_BARRIER_ALGORITHM:-hierarchical}
export FI_CXI_DEFAULT_TX_SIZE=${FI_CXI_DEFAULT_TX_SIZE:-1024}
export FI_CXI_DEVICE_NAME=${FI_CXI_DEVICE_NAME:-cxi0,cxi4}
export FI_MR_CACHE_MAX_COUNT=${FI_MR_CACHE_MAX_COUNT:-32768}
export FI_MR_CACHE_MAX_SIZE=${FI_MR_CACHE_MAX_SIZE:--1}
unset SHMEM_OFI_PUT_PIGGYBACK SMA_OFI_PUT_PIGGYBACK
unset SHMEM_OFI_BOUNCE_ARENA SMA_OFI_BOUNCE_ARENA
{
    printf 'nodes=%s\ncores_per_node=%s\npes=%s\nrepeats=%s\n' "$nodes" "$cores" "$pes" "$repeats"
    printf 'library=%s\nlibrary_sha256=%s\nbenchmark=%s\n' "$library" "$library_hash" "$benchmark"
    printf 'command='; printf '%q ' "$launcher" "${launcher_args[@]}" "$benchmark" "${benchmark_args[@]}"; printf '\n'
    printf 'core_map=%s\npbs_job_id=%s\n' "${CORE_MAP:-MPI defaults}" "${PBS_JOBID:-none}"
    env | LC_ALL=C sort | awk '/^(SHMEM_|FI_CXI_|FI_MR_|I_MPI_|LD_LIBRARY_PATH=)/'
} >"$log_dir/settings.txt"
printf 'repeat\tarm\tpool\tnode_budget\texit_status\tevidence\tseconds\tlog\n' >"$log_dir/summary.tsv"
printf 'Launching %s runs: %s nodes, %s PEs/node; logs: %s\n' "$((3 * repeats))" "$nodes" "$cores" "$log_dir"
for ((repeat=1; repeat<=repeats; repeat++)); do
    case $(((repeat - 1) % 3)) in
        0) arms=(independent-64 independent-128 shared-64);;
        1) arms=(independent-128 shared-64 independent-64);;
        2) arms=(shared-64 independent-64 independent-128);;
    esac
    for arm in "${arms[@]}"; do
        case $arm in
            independent-64) pool=64; node_budget=0;;
            independent-128) pool=128; node_budget=0;;
            shared-64) pool=128; node_budget=$budget;;
        esac
        export SHMEM_MAX_BOUNCE_BUFFERS=$pool SHMEM_OFI_BOUNCE_NODE_BUDGET=$node_budget
        current_hash=$(sha256sum "$library")
        [[ ${current_hash%% *} == "$library_hash" ]] || die "SOS library changed during this job"
        log="$log_dir/repeat-$repeat-$arm.log"
        printf 'RUN %s/%s %s: pool=%s node_budget=%s\n' "$repeat" "$repeats" "$arm" "$pool" "$node_budget"
        start=$SECONDS
        status=0
        timeout --kill-after=30s "$timeout_duration" \
            "$launcher" "${launcher_args[@]}" "$benchmark" "${benchmark_args[@]}" >"$log" 2>&1 || status=$?
        elapsed=$((SECONDS - start))
        evidence=fail
        if [[ $status == 0 ]] && awk -v nodes="$nodes" -v cores="$cores" -v budget="$node_budget" -v pool="$pool" '
            /ERROR:|Abort[(]|Sandia OpenSHMEM exited in error/ {bad=1}
            /^PEs:/ {pe_seen++; if($2!=nodes*cores) bad=1}
            /Error rate[[:space:]]*=/ {
                errors_seen++
                if(split($4,errors,"/")!=2 || errors[1]!~/^[0-9]+$/ ||
                   errors[2]!~/^[0-9]+$/ || errors[1]+0!=0 || errors[2]+0<=0) bad=1
            }
            /SHMEM_MAX_BOUNCE_BUFFERS[[:space:]]/ {if($2==pool) pool_seen=1; else bad=1}
            /SHMEM_OFI_BOUNCE_NODE_BUDGET[[:space:]]/ {if($2==budget) budget_seen=1; else bad=1}
            /SHMEM_OFI_PUT_MORE_BATCH[[:space:]]/ {if($2!=0) bad=1; more_seen=1}
            /OFI immediate bounce:/ {
                owners++
                for(i=1;i<=NF;i++) if(split($i,a,"=")==2) o[a[1]]=a[2]
                if(o["local_mr"]!=1 || o["retirement"]!="counter" || o["stx_idx"]!=-1 ||
                   o["counter_puts"]+0<=0 || o["bounce_puts"]!=o["counter_puts"] ||
                   o["counter_puts"]!=o["reclaimed"]) bad=1
            }
            /OFI node budget:/ {
                leaders++
                for(k in v) delete v[k]
                for(i=1;i<=NF;i++) if(split($i,a,"=")==2) v[a[1]]=a[2]
                count=split("root local_pes budget chunk pool_max initial_shared available leases misses borrowed returned max_pe_quota",keys," ")
                for(i=1;i<=count;i++) if(v[keys[i]]!~/^[0-9]+$/) bad=1
                if(seen[v["root"]]++ || v["local_pes"]!=cores || v["budget"]!=budget ||
                   v["chunk"]!=16 || v["pool_max"]!=128 ||
                   v["initial_shared"]!=budget-cores*16 || v["available"]!=v["initial_shared"] ||
                   v["borrowed"]!=v["returned"] || v["max_pe_quota"]>128) bad=1
                borrowed+=v["borrowed"]
            }
            END {exit !(owners==1 && pe_seen==1 && errors_seen==1 &&
                        pool_seen && budget_seen && more_seen && !bad &&
                        (budget ? leaders==nodes && borrowed>0 : leaders==0))}
            ' "$log"; then evidence=pass; fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$repeat" "$arm" "$pool" "$node_budget" "$status" "$evidence" "$elapsed" "$log" >>"$log_dir/summary.tsv"
        [[ $status == 0 && $evidence == pass ]] ||
            die "run failed or lacks required retirement/admission evidence: $log (exit $status); remaining runs skipped"
        printf 'PASS: %s (%ss wall time; benchmark metrics are in the log)\n' "$log" "$elapsed"
    done
done
printf 'Completed %s runs. Results: %s/summary.tsv\n' "$((3 * repeats))" "$log_dir"

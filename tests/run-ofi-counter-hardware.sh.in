#!/bin/sh
# Generated by config.status. Run on two CXI hosts through the supplied launcher.
set -eu
sos_build_dir="@abs_top_builddir@"
if [ "$#" -lt 2 ]; then
    echo "usage: $0 /abs/ofi_counter_hardware launcher args..." >&2
    exit 2
fi
binary=$1
shift
case "$binary" in /*) ;; *) echo "test binary must be absolute" >&2; exit 2 ;; esac
if [ ! -f "$binary" ] || [ ! -x "$binary" ]; then
    echo "existing executable required: $binary; no builds are performed" >&2
    exit 2
fi
log_dir=${SOS_OFI_LOG_DIR:-$sos_build_dir/logs/counter-hardware-$(date +%Y%m%d-%H%M%S)}
if [ -e "$log_dir" ]; then
    echo "use a new log directory; $log_dir already exists" >&2
    exit 2
fi
mkdir -p "$log_dir"
sha256sum "$binary" >"$log_dir/test-binary.sha256"
printf '%s\n' "$@" >"$log_dir/launcher-arguments.txt"
if [ -f "$sos_build_dir/sos-build-source.txt" ]; then
    cp "$sos_build_dir/sos-build-source.txt" "$log_dir/sos-build-source.txt"
    if ! grep -Eq '^build_completed_utc=.+$' "$log_dir/sos-build-source.txt"; then
        echo "build record has no completion time; refresh successfully before testing" >&2
        exit 2
    fi
else
    echo "build record missing; refresh using scripts/rebuild-ofi.sh" >&2
    exit 2
fi
printf 'case\tbytes\texit_status\tlog\n' >"$log_dir/summary.tsv"
for test_case in rebase preexisting-error delivery-error; do
    case "$test_case" in
        rebase) sizes="1024 4096 8192" ;;
        *) sizes=1024 ;;
    esac
    for bytes in $sizes; do
        log=$log_dir/$test_case-$bytes.log
        status=0
        timeout "${SOS_OFI_TEST_TIMEOUT:-120s}" \
            "$@" "$binary" "$test_case" "$bytes" >"$log" 2>&1 || status=$?
        printf '%s\t%s\t%s\t%s\n' "$test_case" "$bytes" "$status" "$log" \
            >>"$log_dir/summary.tsv"
        valid=0
        if [ "$status" = 0 ] &&
           grep -Eq "^rank=0 provider=cxi .* client_keys=1 test_limit=4 bytes=$bytes libfabric=" "$log" &&
           grep -Eq "^rank=1 provider=cxi .* client_keys=1 test_limit=4 bytes=$bytes libfabric=" "$log"; then
            case "$test_case" in
                rebase)
                    if grep -Fxq "PASS rebase bytes=$bytes epochs=16 writes=288 rebases=71 receiver_payload_checks=272" "$log"; then
                        valid=1
                    fi ;;
                preexisting-error)
                    if grep -Eq '^PASS preexisting-error counter_errors=[1-9][0-9]* cq_errors=0$' "$log" &&
                       grep -Fxq 'healthy baseline delivery and receiver payload check completed' "$log" &&
                       grep -Fxq 'preexisting hardware counter error observed before wait' "$log" &&
                       grep -Eq '^rank=0 OFI put delivery counter reports [1-9][0-9]* failed operation\(s\)$' "$log"; then
                        valid=1
                    fi ;;
                delivery-error)
                    if grep -Eq '^PASS delivery-error (counter_errors=[1-9][0-9]* cq_errors=[0-9]+|counter_errors=0 cq_errors=[1-9][0-9]*)$' "$log" &&
                       grep -Fxq 'healthy baseline delivery and receiver payload check completed' "$log" &&
                       grep -Fxq 'revoked-key write accepted; entering delivery wait' "$log" &&
                       grep -Eq '^rank=0 (hardware CQ delivery error:|OFI put delivery counter reports [1-9])' "$log"; then
                        valid=1
                    fi ;;
            esac
        fi
        if [ "$valid" != 1 ]; then
            echo "FAIL/INVALID: $log (exit $status)" >&2
            exit 1
        fi
        echo "PASS $test_case bytes=$bytes: $log"
    done
done
echo "CXI counter hardware suite completed: $log_dir"
